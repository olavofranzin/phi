# Backend do webview PHI — copie para .env e preencha no VPS.
# NUNCA versione o .env preenchido (o .gitignore já ignora).

# JSON COMPLETO da service account (uma linha ou com \n escapado).
# Ex.: '{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"phi-workflow-sa@phi-production-488720.iam.gserviceaccount.com", ...}'
GCP_SA_KEY=

# Projeto de billing/execução do job BigQuery.
# Use o projeto ao qual a service account pertence. Com a antigravity-agent,
# é o mesmo do dataset.
BQ_BILLING_PROJECT=project-0e7c58d4-656f-49e8-807

# Projeto onde vive o dataset phi_prod.
BQ_DATA_PROJECT=project-0e7c58d4-656f-49e8-807

# Porta HTTP do backend.
PORT=8080
